@inherits ReactiveComponentBase<TaxonCardViewModel>

@if (ViewModel?.Taxon != null)
{
    <MudCard Style="width: 300px; margin: 10px;">
        <MudCardHeader>
            <h2>@ViewModel.Taxon.NameScientific</h2>
        </MudCardHeader>
        <MudCardContent>
            <div>
                <MudLink Href="@ViewModel.ColHref" Target="_blank">@TaxonCardViewModel.ColLinkName</MudLink>
            </div>
        </MudCardContent>
    </MudCard>
}